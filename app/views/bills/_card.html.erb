<div class='flex flex-col border border-congress-800 rounded-2xl p-8 w-2xl border-t-16 bg-congress-w'>
  <div class='flex flex-row gap-8 justify-between'>
    <div class='flex flex-col justify-center gap-2.5'>
      <% if bill.rating.nil? %>
        <p class='text-congress-800 text-xs'>No Rating</p>
      <% else %>
        <p class='text-congress-800 text-xs'><%= sanitize(generate_stars(bill.rating)) %> (Crazy Scale <%= bill.rating %>/10)</p>
      <% end %>
      <%# title %>
      <p class='text-congress-800 text-xs max-w-96'><%= bill.title %></p>
    </div>
    <div class='flex flex-col gap-3'>
      <div class='w-40 h-40 rounded-lg bg-congress-800 '>
        <%# image %>
        <div class='w-full h-full flex justify-center items-center'>
          <%= render partial: 'shared/svg/one_two'%>
        </div>
      </div>
      <div class='w-full '>
        <%= link_to "View Details", bill_path(bill), class: "rounded-lg w-full bg-congress-800 hover:bg-congress-600 hover:cursor-pointer text-white text-sm font-bold py-2 px-4 block text-center", data: { turbo: false } %>
      </div>
    </div>
  </div>
  <div>
    <%= render partial: 'bills/show/progress_bar', locals: { current_status: determine_bill_status(bill) } %>
  </div>
</div>