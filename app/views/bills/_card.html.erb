<div class='flex flex-col border border-congress-800 rounded-2xl p-8 w-xl border-t-16 bg-congress-w'>
  <div class='flex flex-row gap-8 justify-between'>
    <div class='flex flex-col justify-center gap-2.5'>
      <%# rating %>
      <p class='text-congress-800 text-xs'>&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9734;&#9734;&#9734; (Crazy Scale 7/10)</p>
      <%# title %>
      <p class='text-congress-800 text-xs max-w-96'><%= bill.title %></p>
    </div>
    <div class='flex flex-col gap-3'>
      <div class='w-40 h-40 rounded-lg bg-congress-800 '>
        <%# image %>
        <div class='w-full h-full flex justify-center items-center'>
          <%= render partial: 'shared/svg/one_two'%>
        </div>
      </div>
      <div class='w-auto '>
        <%# view details button %>
        <button class="rounded-lg w-full bg-congress-800 hover:bg-congress-600 hover:cursor-pointer text-white text-sm font-bold py-2 px-4">
          View Details
        </button>
      </div>
    </div>
  </div>
  <div>
    <%# progress bar %>
  </div>
</div>