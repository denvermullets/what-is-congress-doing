<div class='flex flex-col border border-congress-800 rounded-lg p-8 w-xl'>
  <div class='flex flex-row gap-8 justify-between'>
    <div class='flex flex-col justify-center gap-2.5'>
      <%# rating %>
      <p class='text-congress-800 text-xs'>&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9733;&#9734;&#9734;&#9734; (Crazy Scale 7/10)</p>
      <%# title %>
      <p class='text-congress-800 text-xs max-w-96'><%= bill.title %></p>
    </div>
    <div class='flex flex-col gap-3'>
      <div class='w-40 h-40 rounded-lg bg-congress-800'>
        <%# image %>
      </div>
      <div class='w-auto h-8 rounded-lg bg-congress-800'>
        <%# view details button %>
      </div>
    </div>
  </div>
  <div>
    <%# progress bar %>
  </div>
</div>