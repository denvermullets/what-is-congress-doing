<div class='flex flex-col w-full'>
  <div class="flex flex-row justify-center items-center w-full h-[400px]">
    <div class="text-congress-800">
      <h1 class="text-7xl font-display font-bold mb-4">
        What is Congress Doing?
      </h1>
      <h3 class="text-3xl font-display">
        Congressional Reps earn at least $174,000 a year.
      </h3>
      <h3 class="text-3xl font-display">
        Congress works for US and this is what they choose to spend our tax dollars doing.
      </h3>
    </div>
  </div>
  <div class='flex flex-row flex-wrap gap-8 px-36 items-center justify-center'>
    <% bills.each do |bill| %>
      <%= render partial: 'card', locals: { bill: }%>
    <% end %>
  </div>
</div>