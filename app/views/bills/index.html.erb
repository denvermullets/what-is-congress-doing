<div class='flex flex-col w-full'>
  <div class="flex flex-row justify-center items-center w-full h-[400px] header-grids">
    <div class="text-congress-800">
      <h1 class="text-7xl font-display font-bold mb-4">
        What is Congress Doing?
      </h1>
      <h3 class="text-3xl font-display">
        Congressional Reps earn at least $174,000 a year.
      </h3>
      <h3 class="text-3xl font-display">
        Congress works for US and this is what they choose to spend our tax dollars doing.
      </h3>
    </div>
  </div>
  <div class='w-full flex flex-col items-center justify-center mb-16 px-72'>
    <%= turbo_frame_tag 'bills_content' do %>
      <div class='flex flex-row items-center justify-between p-6 space-x-4'>
        <%== pagy_info(pagy) %>
        <%== pagy_nav(pagy, link_extra: 'data-turbo-stream="true"') %>
      </div>
      <div id="bills-container" class='flex flex-wrap justify-center gap-8 w-full'>
        <% bills.each do |bill| %>
          <%= render partial: 'card', locals: { bill: } %>
        <% end %>
      </div>
    <% end %>
    <div class='flex flex-row items-center justify-between p-6 space-x-4'>
      <%== pagy_info(pagy) %>
      <%== pagy_nav(pagy, link_extra: 'data-turbo-stream="true"') %>
    </div>
  </div>
</div>
