<div class='flex flex-col border border-congress-800 rounded-2xl  border-t-16 bg-congress-w text-congress-800 w-[344px]'>
  <div class='flex flex-col gap-4 p-4'>
    <p class='font-bold'><%= sponsor == true ? 'Sponsored By:' : 'Co-Sponsored By:' %></p>
    <% sponsors.each do |sponsor| %>
      <div class='flex flex-row gap-4'>
        <div style="width: 64px; height: 76px; overflow: hidden; position: relative; flex-shrink: 0; border-radius: 16px;">
          <% if sponsor.image_url.present? %>
            <%= image_tag sponsor.image_url, style: "position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" %>
          <% else %>
            <div style="width: 64px; height: 76px; flex-shrink: 0; border-radius: 16px;" class="bg-congress-800 border border-congress-600"></div>
          <% end %>
        </div>
        <div class='flex flex-col space-y-2 ml-3'>
          <div>
            <p class='text-xs'><%= "#{get_abbr(sponsor.display_name)}" %></p>
            <p><%= strip_abbr(sponsor.display_name) %></p>
            <p class='text-xs'><%= sponsor.birth_year.nil? ? 'Unknown' : "Age: #{Time.now.year - sponsor.birth_year.to_i}" %></p>
          </div>
          <div>
            <p class='text-xs'><%= link_to sanitize(sponsor.official_website_url), sanitize(sponsor.official_website_url), target: '_blank', rel: 'noopener noreferrer' %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>