<div class='flex flex-col border border-congress-800 rounded-2xl p-8 border-t-16 bg-congress-w text-congress-800'>
  <div class='flex flex-row gap-8'>
    <div class='flex flex-col gap-3'>
      <div class='flex flex-col '>
        <p class='text-2xl font-semibold'><%= "#{bill.bill_type} #{bill.number}" %></p>
        <p><%= "#{bill.congress}th Congress" %> </p>
      </div>
      <div class='w-40 h-40 rounded-lg bg-congress-800 '>
        <%# image %>
        <div class='w-full h-full flex justify-center items-center'>
          <%= render partial: 'shared/svg/one_two'%>
        </div>
      </div>
      <div class='flex-col'>
        <p class='text-xl font-bold'>Crazy Rating: <%= bill.rating %></p>
        <p class='text-base'><%= sanitize(generate_stars(bill.rating)) %></p>
      </div>
    </div>
    <div class='flex flex-col gap-4'>
      <p class='text-2xl font-semibold'><%= bill.title %></p>
      <div>
        <p class='font-semibold'>Summary:</p>
        <p><%= bill.bill_text.ai_json['summary'] %></p>
      </div>
      <div>
        <p class='font-semibold'>Conclusion:</p>
        <p><%= bill.bill_text.ai_json['ratingDesc'] %></p>
      </div>
    </div>
  </div>
  <div>
    <%# progress bar %>
  </div>
</div>